generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String?  @unique
  name      String   @default("Guest Debater")
  createdAt DateTime @default(now())
  debates   Debate[]

  @@map("users")
}

model Debate {
  id           String          @id @default(uuid())
  topic        String
  status       String          @default("CREATED")
  rounds       Int             @default(3)
  currentRound Int             @default(0)
  style        String          @default("OXFORD")
  difficulty   String          @default("STANDARD")
  language     String          @default("English")
  winner       String?
  userId       String?
  user         User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt    DateTime        @default(now())
  completedAt  DateTime?

  agents       Agent[]
  messages     DebateMessage[]
  result       JudgeResult?

  @@map("debates")
}

model Agent {
  id           String          @id @default(uuid())
  debateId     String
  debate       Debate          @relation(fields: [debateId], references: [id], onDelete: Cascade)
  name         String
  role         String
  position     String
  systemPrompt String
  avatar       String?

  messages     DebateMessage[]

  @@map("agents")
}

model DebateMessage {
  id         String   @id @default(uuid())
  debateId   String
  debate     Debate   @relation(fields: [debateId], references: [id], onDelete: Cascade)
  agentId    String
  agent      Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  round      Int
  turn       String   @default("ARGUMENT")
  content    String
  tokenCount Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([debateId, round])
  @@map("debate_messages")
}

model JudgeResult {
  id               String   @id @default(uuid())
  debateId         String   @unique
  debate           Debate   @relation(fields: [debateId], references: [id], onDelete: Cascade)
  winner           String
  agentAScore      Int      @default(0)
  agentBScore      Int      @default(0)
  scores           String
  reasoning        String
  agentAStrengths  String   @default("[]")
  agentBStrengths  String   @default("[]")
  agentAWeaknesses String   @default("[]")
  agentBWeaknesses String   @default("[]")
  keyTurningPoints String?  @default("[]")
  finalVerdict     String
  createdAt        DateTime @default(now())

  @@map("judge_results")
}
